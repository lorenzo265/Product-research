{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sinal.schema.json",
  "title": "Sinal do radar",
  "description": "Dor observada por uma lente. Sinal não é oportunidade: vira oportunidade quando agrupado num cartão.",
  "type": "object",
  "required": ["id", "lente", "trilhas", "setor", "dor", "quem_sofre", "fatos", "coletado_em", "coletor", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^s-\\d{4}-\\d{4}$"},
    "lente": {"type": "integer", "minimum": 1, "maximum": 11},
    "trilhas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["G", "M", "S"]}},
    "setor": {"type": "string", "minLength": 2},
    "dor": {"type": "string", "minLength": 10},
    "sentido": {
      "description": "dor (padrão): dinheiro mal servido. mercado_servido: sinal inverso, um player bem avaliado ou dominante já resolve a dor; é evidência contra, não candidato.",
      "enum": ["dor", "mercado_servido"]
    },
    "quem_sofre": {"type": "string", "minLength": 2},
    "quem_paga": {"type": ["string", "null"]},
    "cifra": {
      "description": "Dinheiro que quem sofre já gasta ou perde com a dor (salário pago para fazer à mão, orçamento de projeto, multa, perda). Captação de concorrente e contagem de clientes não são cifra: ficam nos fatos. Sinal com cifra vale mais que sinal sem.",
      "type": ["object", "null"],
      "required": ["valor", "unidade", "fato"],
      "properties": {
        "valor": {"type": "number"},
        "unidade": {"type": "string"},
        "fato": {"type": "string", "pattern": "^f-\\d{4}-\\d{4}$"}
      }
    },
    "recorrencia": {
      "description": "Evidência de que a dor se repete: contagem com período e fonte (ex.: 14 projetos do tipo em 30 dias no 99Freelas). Modelo de cobrança de um produto não é recorrência.",
      "type": ["string", "null"]
    },
    "fatos": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^f-\\d{4}-\\d{4}$"}},
    "coletado_em": {"type": "string", "format": "date"},
    "coletor": {"type": "string"},
    "status": {"enum": ["novo", "agrupado", "descartado"]},
    "oportunidade": {"type": ["string", "null"], "pattern": "^OP-\\d{4}$"},
    "nota": {"type": "string"},
    "historico": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["data", "campo", "valor_anterior"],
        "properties": {
          "data": {"type": "string", "format": "date"},
          "campo": {"type": "string"},
          "valor_anterior": {},
          "motivo": {"type": "string"}
        }
      }
    }
  }
}
